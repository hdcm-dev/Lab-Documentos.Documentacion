{
  // Los registros del HttpClient imprimen la URL del servidor: en Warning no aparecen en la consola.
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  // OLLAMA_ENDPOINT y OLLAMA_MODEL, si están definidas, pisan Endpoint y Modelo (ComposicionDeIA).
  "AI": {
    "Endpoint": "http://localhost:11434",
    "Modelo": "qwen3.5:4b",
    "NumCtx": 8192,
    "LargoMaximoDeEntrada": 2000,
    // Model card de Qwen/Qwen3.5-4B, «Instruct (or non-thinking) mode for general tasks», consultada el 2026-10-28.
    "Muestreo": {
      "Temperatura": 0.7,
      "TopP": 0.8,
      "TopK": 20,
      "PenalizacionPorPresencia": 1.5,
      "ApagarRazonamiento": true
    }
  }
}
