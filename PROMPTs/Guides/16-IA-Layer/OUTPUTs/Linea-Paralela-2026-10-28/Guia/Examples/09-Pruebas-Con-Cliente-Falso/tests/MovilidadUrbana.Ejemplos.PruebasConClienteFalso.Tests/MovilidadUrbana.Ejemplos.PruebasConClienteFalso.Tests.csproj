<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>MovilidadUrbana.Ejemplos.PruebasConClienteFalso.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versiones consultadas en nuget.org el 2026-10-28. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Evaluación: sólo en las pruebas; la API no la lleva. -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MovilidadUrbana.Ejemplos.PruebasConClienteFalso\MovilidadUrbana.Ejemplos.PruebasConClienteFalso.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.ConModelo.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- ConModelo/ arma el anfitrión con los mismos appsettings de la API. -->
    <None Include="..\..\src\MovilidadUrbana.Ejemplos.PruebasConClienteFalso\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MovilidadUrbana.Ejemplos.PruebasConClienteFalso\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
