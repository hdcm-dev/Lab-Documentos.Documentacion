<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ejemplo 08: cliente MCP con lista blanca y un agente de MAF que usa las herramientas del servidor propio. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MovilidadUrbana.Ejemplos.Mcp.Cliente</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versiones consultadas en nuget.org el 2026-10-28; iguales a la tabla de paquetes de la guía. -->
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- En una consola, ValidateDataAnnotations() vive en este paquete. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sólo para levantar el servidor del ejemplo en el mismo proceso; la conexión igual va por HTTP. -->
    <ProjectReference Include="..\MovilidadUrbana.Ejemplos.Mcp.Servidor\MovilidadUrbana.Ejemplos.Mcp.Servidor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
