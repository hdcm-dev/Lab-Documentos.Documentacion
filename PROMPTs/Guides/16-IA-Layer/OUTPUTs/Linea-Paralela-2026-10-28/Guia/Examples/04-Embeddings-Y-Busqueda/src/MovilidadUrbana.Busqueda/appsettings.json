{
  // Los registros del HttpClient escriben la URL del servidor: en Warning no salen a la consola ni a las capturas.
  "Logging": { "LogLevel": { "Default": "Warning" } },
  // OLLAMA_ENDPOINT y OLLAMA_EMBEDDING_MODEL, si están definidas, pisan Endpoint y ModeloDeEmbeddings.
  "AI": {
    "Modo": "Ollama",
    "Endpoint": "http://localhost:11434",
    "ModeloDeEmbeddings": "qwen3-embedding:0.6b",
    // Dimensión declarada del almacén. qwen3-embedding:0.6b da 1024 (admite de 32 a 1024 por MRL).
    // Si se borra la clave, se adopta el largo del primer embedding medido al arrancar.
    "DimensionDeEmbeddings": 1024,
    "Busqueda": {
      "Top": 3,
      // Model card de Qwen/Qwen3-Embedding-0.6B (consultada el 2026-10-28): instrucción sólo en la consulta,
      // con el formato «Instruct: {tarea}\nQuery:{consulta}», y redactada en inglés aunque el texto sea multilingüe.
      "InstruccionDeConsulta": "Given a question from a person filling in a mobility survey or a locality form, retrieve the requirement statement that answers it"
    }
  }
}
