<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cableado/: sin modelo, deterministas, siempre. ConModelo/: contra el servidor Ollama de prueba, por turno. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MovilidadUrbana.Busqueda.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versiones consultadas en nuget.org el 2026-10-28. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MovilidadUrbana.Busqueda\MovilidadUrbana.Busqueda.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
