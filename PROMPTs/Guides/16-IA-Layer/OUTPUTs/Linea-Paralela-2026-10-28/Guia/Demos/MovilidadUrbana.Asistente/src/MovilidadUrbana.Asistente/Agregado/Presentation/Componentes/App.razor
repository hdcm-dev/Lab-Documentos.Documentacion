@inject MovilidadUrbana.ApiWeb.Infrastructure.Sessions.SessionContext Session
<!DOCTYPE html>
<html lang="es-AR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* Como en MovilidadUrbana.Web: App.razor se renderiza con la petición HTTP a mano y es el único lugar
       donde se lee la sesión que fijó la cookie. Desde acá viaja como parámetro hasta el circuito. *@
    <Routes @rendermode="InteractiveServer" SessionId="@Session.Id" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
