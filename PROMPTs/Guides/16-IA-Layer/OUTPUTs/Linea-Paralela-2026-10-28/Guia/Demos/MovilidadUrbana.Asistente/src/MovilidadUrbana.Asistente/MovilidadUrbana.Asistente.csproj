<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Movilidad Urbana con una capa de IA. Las carpetas Domain/, Application/, Contracts/, Controllers/,
       Sessions/ e Infrastructure/ son copia literal de MovilidadUrbana.ApiWeb (ver PROCEDENCIA.md) y
       conservan sus espacios de nombres MovilidadUrbana.ApiWeb.*. Todo lo nuevo vive en Agregado/, con
       espacios de nombres MovilidadUrbana.Asistente.*. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MovilidadUrbana.Asistente</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MovilidadUrbana.Asistente.Tests" />
  </ItemGroup>

</Project>
