{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cuerpo.schema.json",
  "title": "Frontmatter de documento del cuerpo de Colmenar",
  "description": "Los diez campos más description. confidence es obligatorio si origin no es human.",
  "type": "object",
  "required": [
    "doc_id",
    "doc_type",
    "title",
    "status",
    "origin",
    "owner",
    "last_review",
    "audience",
    "traces",
    "description"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
    },
    "doc_type": {
      "enum": [
        "ficha",
        "anexo",
        "rrd",
        "proceso",
        "registro-audiencias",
        "operativa"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "vigente",
        "borrador",
        "obsoleto"
      ]
    },
    "origin": {
      "enum": [
        "human",
        "ia-assisted",
        "ia-generated"
      ]
    },
    "confidence": {
      "enum": [
        "alta",
        "media",
        "baja"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "last_review": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "humano",
          "desarrollo",
          "qa",
          "devops",
          "po",
          "analista",
          "persona-usuaria"
        ]
      }
    },
    "traces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+(@\\d+\\.\\d+)?$"
      }
    }
  },
  "if": {
    "properties": {
      "origin": {
        "enum": [
          "ia-assisted",
          "ia-generated"
        ]
      }
    }
  },
  "then": {
    "required": [
      "confidence"
    ]
  }
}
