{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ayuda.schema.json",
  "title": "Frontmatter de página de ayuda (propuesta C-VERIFICACION, Q14/Q38)",
  "type": "object",
  "required": ["title", "description"],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 3 },
    "roles": { "type": "array", "minItems": 1, "items": { "enum": ["Student", "Administrator"] } },
    "order": { "type": "integer" },
    "topic": { "type": "string" },
    "traces": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(CU|RN)-\\d{5}@\\d+\\.\\d+$" } },
    "translation_of": { "type": "string", "pattern": "^[a-z]{2}/[a-z0-9/-]+\\.md(@(CU|RN)-\\d{5}@\\d+\\.\\d+)?$" }
  },
  "oneOf": [ { "required": ["roles"] }, { "required": ["translation_of"] } ]
}
