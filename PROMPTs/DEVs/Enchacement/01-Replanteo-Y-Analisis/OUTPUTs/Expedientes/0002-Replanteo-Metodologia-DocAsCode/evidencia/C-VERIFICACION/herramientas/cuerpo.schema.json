{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cuerpo.schema.json",
  "title": "Frontmatter de documento del cuerpo (propuesta C-VERIFICACION, Q14)",
  "type": "object",
  "required": ["doc_id", "doc_type", "title", "status", "origin", "owner", "last_review", "audience", "traces"],
  "properties": {
    "doc_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$" },
    "doc_type": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "status": { "enum": ["draft", "review", "vigente", "superseded", "deprecated"] },
    "origin": { "enum": ["human", "agent", "mixed"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "owner": { "type": "string", "minLength": 1 },
    "last_review": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "audience": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "traces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+(@\\d+\\.\\d+)?$" } }
  },
  "if": { "properties": { "origin": { "enum": ["agent", "mixed"] } } },
  "then": { "required": ["confidence"] }
}
